{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "shims-vue.d.ts",
    "server/**/*.ts",
    "server/**/*.d.ts",
    "pages/**/*.ts",
    "pages/**/*.vue",
    "components/**/*.ts",
    "components/**/*.vue",
    "renderer/**/*.ts",
    "renderer/**/*.vue",
    "stores/**/*.ts",
    "locales/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
